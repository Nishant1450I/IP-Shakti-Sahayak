# LLM Provider Configuration
# Supported values: gemini (ollama coming later)
LLM_PROVIDER=gemini

# Google Gemini API Key (backend only — never exposed to frontend)
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Gemini model (configurable so model retirement only needs a .env change)
GEMINI_MODEL=gemini-3.6-flash

# Backend server port (default: 3001)
PORT=3001